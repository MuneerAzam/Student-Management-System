[Unit]
Description=Gunicorn instance to serve Student Management System
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/student-management
Environment="PATH=/home/ubuntu/student-management/venv/bin"
Environment="DATABASE_URL=postgresql://user:password@localhost/dbname"
ExecStart=/home/ubuntu/student-management/venv/bin/gunicorn -w 4 -b 0.0.0.0:5000 app:app

[Install]
WantedBy=multi-user.target